{% extends 'base.html.twig' %}

{% block title %}Liste des Étudiants{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-people-fill text-primary"></i> Étudiants</h1>
    <a href="{{ path('app_etudiant_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Ajouter un Étudiant
    </a>
</div>

{# Barre de recherche et filtres #}
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="recherche" class="form-control"
                           placeholder="Rechercher par nom, prénom ou numéro..."
                           value="{{ terme ?? '' }}">
                </div>
            </div>
            <div class="col-md-4">
                <select name="niveau" class="form-select">
                    <option value="">Tous les niveaux</option>
                    <option value="L1" {% if niveau == 'L1' %}selected{% endif %}>Licence 1</option>
                    <option value="L2" {% if niveau == 'L2' %}selected{% endif %}>Licence 2</option>
                    <option value="L3" {% if niveau == 'L3' %}selected{% endif %}>Licence 3</option>
                    <option value="M1" {% if niveau == 'M1' %}selected{% endif %}>Master 1</option>
                    <option value="M2" {% if niveau == 'M2' %}selected{% endif %}>Master 2</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-funnel"></i> Filtrer
                </button>
            </div>
        </form>
    </div>
</div>

{% if etudiants is empty %}
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> Aucun étudiant trouvé.
        <a href="{{ path('app_etudiant_new') }}" class="alert-link">Ajouter le premier étudiant</a>.
    </div>
{% else %}
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>N° Étudiant</th>
                        <th>Nom Complet</th>
                        <th>Email</th>
                        <th>Niveau</th>
                        <th>Moyenne</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for etudiant in etudiants %}
                        <tr>
                            <td><code>{{ etudiant.numeroEtudiant }}</code></td>
                            <td>
                                <strong>{{ etudiant.nom }}</strong> {{ etudiant.prenom }}
                            </td>
                            <td>{{ etudiant.email }}</td>
                            <td>
                                <span class="badge bg-secondary">{{ etudiant.niveau }}</span>
                            </td>
                            <td>
                                {% if etudiant.notes is not empty %}
                                    <strong>{{ etudiant.moyenneGenerale }}/20</strong>
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if etudiant.notes is not empty %}
                                    {% if etudiant.admis %}
                                        <span class="badge bg-success">Admis</span>
                                    {% else %}
                                        <span class="badge bg-danger">Ajourné</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge bg-secondary">En cours</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}"
                                   class="btn btn-sm btn-outline-info" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}"
                                   class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('app_etudiant_delete', {'id': etudiant.id}) }}"
                                      style="display:inline"
                                      onsubmit="return confirm('Confirmer la suppression de cet étudiant ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etudiant.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2">Total : {{ etudiants|length }} étudiant(s)</p>
{% endif %}
{% endblock %}
