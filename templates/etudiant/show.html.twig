{% extends 'base.html.twig' %}

{% block title %}Fiche de {{ etudiant.nomComplet }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-person-fill text-primary"></i> {{ etudiant.nomComplet }}</h1>
    <div>
        <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Modifier
        </a>
        <a href="{{ path('app_etudiant_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="row">
    {# Informations personnelles #}
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-person-badge"></i> Informations Personnelles
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <th class="text-muted">N° Étudiant</th>
                        <td><code>{{ etudiant.numeroEtudiant }}</code></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Nom</th>
                        <td>{{ etudiant.nom }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Prénom</th>
                        <td>{{ etudiant.prenom }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Email</th>
                        <td><a href="mailto:{{ etudiant.email }}">{{ etudiant.email }}</a></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Date de Naissance</th>
                        <td>{{ etudiant.dateNaissance|date('d/m/Y') }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Niveau</th>
                        <td><span class="badge bg-secondary">{{ etudiant.niveau }}</span></td>
                    </tr>
                </table>
            </div>
        </div>

        {# Résumé académique #}
        <div class="card">
            <div class="card-header bg-success text-white">
                <i class="bi bi-bar-chart-fill"></i> Résumé Académique
            </div>
            <div class="card-body text-center">
                {% if etudiant.notes is not empty %}
                    <div class="display-4 fw-bold
                        {% if etudiant.admis %}text-success{% else %}text-danger{% endif %}">
                        {{ etudiant.moyenneGenerale }}/20
                    </div>
                    <p class="text-muted mb-2">Moyenne Générale</p>
                    {% if etudiant.admis %}
                        <span class="badge bg-success fs-6">✓ Admis</span>
                    {% else %}
                        <span class="badge bg-danger fs-6">✗ Ajourné</span>
                    {% endif %}
                    <hr>
                    <p class="mb-0"><strong>{{ etudiant.notes|length }}</strong> note(s) enregistrée(s)</p>
                {% else %}
                    <p class="text-muted">Aucune note enregistrée.</p>
                    <a href="{{ path('app_note_new') }}" class="btn btn-sm btn-outline-success">
                        <i class="bi bi-plus"></i> Ajouter une note
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {# Notes #}
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clipboard-check-fill"></i> Notes</span>
                    <a href="{{ path('app_note_new') }}" class="btn btn-sm btn-dark">
                        <i class="bi bi-plus"></i> Nouvelle Note
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                {% if etudiant.notes is empty %}
                    <p class="text-center text-muted p-4">Aucune note pour cet étudiant.</p>
                {% else %}
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Matière</th>
                                <th>Semestre</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Note</th>
                                <th>Mention</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for note in etudiant.notes %}
                                <tr>
                                    <td>{{ note.matiere.nom }}</td>
                                    <td><span class="badge bg-info">{{ note.matiere.semestre }}</span></td>
                                    <td>{{ note.typeEvaluation }}</td>
                                    <td>{{ note.dateEvaluation|date('d/m/Y') }}</td>
                                    <td>
                                        <strong class="{% if note.passante %}text-success{% else %}text-danger{% endif %}">
                                            {{ note.valeur }}/20
                                        </strong>
                                    </td>
                                    <td>{{ note.mention }}</td>
                                    <td>
                                        <a href="{{ path('app_note_edit', {'id': note.id}) }}"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
