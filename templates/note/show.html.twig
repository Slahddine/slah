{% extends 'base.html.twig' %}

{% block title %}Note de {{ note.etudiant.nomComplet }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-clipboard-check-fill text-warning"></i> Détail de la Note</h1>
    <div>
        <a href="{{ path('app_note_edit', {'id': note.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Modifier
        </a>
        <a href="{{ path('app_note_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-warning">
                <i class="bi bi-star-fill"></i> Informations de la Note
            </div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <th class="text-muted">Étudiant</th>
                        <td>
                            <a href="{{ path('app_etudiant_show', {'id': note.etudiant.id}) }}">
                                {{ note.etudiant.nomComplet }}
                            </a>
                            <span class="badge bg-secondary ms-1">{{ note.etudiant.niveau }}</span>
                        </td>
                    </tr>
                    <tr>
                        <th class="text-muted">Matière</th>
                        <td>
                            <a href="{{ path('app_matiere_show', {'id': note.matiere.id}) }}">
                                {{ note.matiere.nom }}
                            </a>
                            <code class="ms-1">{{ note.matiere.code }}</code>
                        </td>
                    </tr>
                    <tr>
                        <th class="text-muted">Semestre</th>
                        <td><span class="badge bg-info">{{ note.matiere.semestre }}</span></td>
                    </tr>
                    <tr>
                        <th class="text-muted">Type d'Évaluation</th>
                        <td>{{ note.typeEvaluation }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Date</th>
                        <td>{{ note.dateEvaluation|date('d/m/Y') }}</td>
                    </tr>
                    <tr>
                        <th class="text-muted">Note</th>
                        <td>
                            <span class="fs-4 fw-bold
                                {% if note.passante %}text-success{% else %}text-danger{% endif %}">
                                {{ note.valeur }}/20
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th class="text-muted">Mention</th>
                        <td>
                            <span class="badge
                                {% if note.valeur >= 16 %}bg-success
                                {% elseif note.valeur >= 14 %}bg-primary
                                {% elseif note.valeur >= 12 %}bg-info
                                {% elseif note.valeur >= 10 %}bg-warning text-dark
                                {% else %}bg-danger{% endif %}">
                                {{ note.mention }}
                            </span>
                        </td>
                    </tr>
                </table>

                <div class="d-flex gap-2 justify-content-end mt-3">
                    <form method="post" action="{{ path('app_note_delete', {'id': note.id}) }}"
                          onsubmit="return confirm('Confirmer la suppression ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ note.id) }}">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Supprimer
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
