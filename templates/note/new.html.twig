{% extends 'base.html.twig' %}

{% block title %}Saisir une Note{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-clipboard-plus-fill text-warning"></i> Saisir une Note</h1>
    <a href="{{ path('app_note_index') }}" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Retour à la liste
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-warning">
                <i class="bi bi-clipboard-check-fill"></i> Informations de la Note
            </div>
            <div class="card-body">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.etudiant) }}
                        {{ form_widget(form.etudiant) }}
                        {{ form_errors(form.etudiant) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.matiere) }}
                        {{ form_widget(form.matiere) }}
                        {{ form_errors(form.matiere) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        {{ form_label(form.valeur) }}
                        {{ form_widget(form.valeur) }}
                        {{ form_errors(form.valeur) }}
                    </div>
                    <div class="col-md-4 mb-3">
                        {{ form_label(form.typeEvaluation) }}
                        {{ form_widget(form.typeEvaluation) }}
                        {{ form_errors(form.typeEvaluation) }}
                    </div>
                    <div class="col-md-4 mb-3">
                        {{ form_label(form.dateEvaluation) }}
                        {{ form_widget(form.dateEvaluation) }}
                        {{ form_errors(form.dateEvaluation) }}
                    </div>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <a href="{{ path('app_note_index') }}" class="btn btn-secondary">
                        <i class="bi bi-x-lg"></i> Annuler
                    </a>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-lg"></i> Enregistrer
                    </button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
