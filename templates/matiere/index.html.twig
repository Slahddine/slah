{% extends 'base.html.twig' %}

{% block title %}Liste des Matières{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-book-fill text-success"></i> Matières</h1>
    <a href="{{ path('app_matiere_new') }}" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Ajouter une Matière
    </a>
</div>

{# Barre de recherche et filtres #}
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="recherche" class="form-control"
                           placeholder="Rechercher par nom ou code..."
                           value="{{ terme ?? '' }}">
                </div>
            </div>
            <div class="col-md-4">
                <select name="semestre" class="form-select">
                    <option value="">Tous les semestres</option>
                    {% for s in ['S1', 'S2', 'S3', 'S4', 'S5', 'S6'] %}
                        <option value="{{ s }}" {% if semestre == s %}selected{% endif %}>
                            Semestre {{ s[1] }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-success w-100">
                    <i class="bi bi-funnel"></i> Filtrer
                </button>
            </div>
        </form>
    </div>
</div>

{% if matieres is empty %}
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle"></i> Aucune matière trouvée.
        <a href="{{ path('app_matiere_new') }}" class="alert-link">Ajouter la première matière</a>.
    </div>
{% else %}
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Nom</th>
                        <th>Semestre</th>
                        <th>Coefficient</th>
                        <th>Volume Horaire</th>
                        <th>Nb. Notes</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for matiere in matieres %}
                        <tr>
                            <td><code>{{ matiere.code }}</code></td>
                            <td><strong>{{ matiere.nom }}</strong></td>
                            <td><span class="badge bg-info">{{ matiere.semestre }}</span></td>
                            <td>{{ matiere.coefficient }}</td>
                            <td>{{ matiere.volumeHoraire }}h</td>
                            <td>{{ matiere.notes|length }}</td>
                            <td class="text-end">
                                <a href="{{ path('app_matiere_show', {'id': matiere.id}) }}"
                                   class="btn btn-sm btn-outline-info" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_matiere_edit', {'id': matiere.id}) }}"
                                   class="btn btn-sm btn-outline-warning" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('app_matiere_delete', {'id': matiere.id}) }}"
                                      style="display:inline"
                                      onsubmit="return confirm('Confirmer la suppression de cette matière ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ matiere.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <p class="text-muted mt-2">Total : {{ matieres|length }} matière(s)</p>
{% endif %}
{% endblock %}
